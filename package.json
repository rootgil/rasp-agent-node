{
  "name": "@queno/agent-node",
  "version": "0.5.2",
  "description": "RASP agent for Node.js - Express, Fastify, NestJS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "sbom.cdx.json",
    "sbom.spdx.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "postbuild": "node scripts/generate-integrity.mjs",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/",
    "test:lab": "vitest run test-lab/integration/",
    "test:e2e": "vitest run test-lab/e2e/",
    "test:stress": "vitest run test-lab/stress/",
    "test:compat": "vitest run test-lab/compat/",
    "test:ci": "npm run typecheck && npm run test:unit && npm run test:lab",
    "benchmark:compare": "node benchmarks/compare-p99.js",
    "benchmark:update-baseline": "node benchmarks/update-baseline.js"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "express": ">=4",
    "fastify": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@types/express": "^5.0.2",
    "@types/node": "^20",
    "@types/supertest": "^6.0.3",
    "dd-trace": "^5.106.0",
    "express": "^4.21.2",
    "fastify": "^5.8.5",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
