# ============================================================================
# rasp-agent-node - variables d'environnement
# ----------------------------------------------------------------------------
# Seules ces 2 variables sont lues par le code de l'agent (src/config.ts).
# Les valeurs ci-dessous sont les DEFAULTS du code (decommente pour surcharger).
# ============================================================================

# URL du collector. Default code : https://collector.rasp.dev
RASP_COLLECTOR_URL=https://collector.rasp.dev

# Cle publique de confiance pour la policy signee (trust anchor, Addendum E.4.1).
# Default code : cle de DEVELOPPEMENT embarquee dans config.ts.
RASP_POLICY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEAI/7DX+UlM7pdRY7QtOhiFufM=
-----END PUBLIC KEY-----"

# ============================================================================
# Reference : options de RaspConfig (PAS lues depuis l'env, passees au
# constructeur new RaspAgent({...}). Defauts du schema Zod, pour info.
# ============================================================================
# apiKey                   = (requis)
# projectId                = (requis)
# agentId                  = (requis)
# agentVersion             = (optionnel)
# mode                     = monitor          # monitor | block
# channel                  = stable           # stable | early | edge
# heartbeatIntervalMs      = 30000            # min 5000
# flushIntervalMs          = 5000             # min 1000
# bufferMaxSize            = 50               # min 1
# transportTimeoutMs       = 5000             # min 500
# auditLog                 = true
# auditLogPath             = ./rasp-audit.log
# auditLogMaxBytes         = 10485760         # 10 * 1024 * 1024
# framework                = (optionnel)
# runtime                  = node
# discoveryFlushIntervalMs = 60000            # min 5000
# hmacSecret               = (optionnel)
