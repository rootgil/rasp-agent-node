# ── RASP agent config ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Get projectId from the dashboard after running: cd rasp && pnpm db:seed

RASP_API_KEY=rasp_demo_key_abc123
RASP_PROJECT_ID=<your-project-id-from-dashboard>
RASP_AGENT_ID=agent_banking_local

# Point to your local collector (cd collector && pnpm dev)
RASP_COLLECTOR_URL=http://localhost:4000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
