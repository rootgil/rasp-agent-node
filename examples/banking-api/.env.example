# ── RASP agent config ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Get projectId from the dashboard after running: cd rasp && pnpm db:seed

RASP_API_KEY=rasp_demo_key_abc123
RASP_PROJECT_ID=<your-project-id-from-dashboard>
RASP_AGENT_ID=agent_banking_local

# Point to your local collector (cd collector && pnpm dev)
RASP_COLLECTOR_URL=http://localhost:4000

# Pinned policy-signing public key (trust anchor). A dev key is built in, so this
# is optional locally. Override for sovereign/on-prem deployments.
# RASP_POLICY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Enforcement mode: "monitor" (default, attacks pass through) or "block" (403).
RASP_MODE=monitor

# Release channel: stable | early | edge (canary cohorts, Addendum D).
RASP_CHANNEL=stable

# Payload integrity (HMAC-SHA256, Addendum E.5). Leave empty to disable.
# Must match the agent's hmacSecret in the dashboard, or the collector's
# global HMAC_SECRET. With the collector's HMAC_REQUIRED=true, a wrong/missing
# secret makes the collector reject the batch.
RASP_HMAC_SECRET=

# Runtime self-protection (Addendum E.7): anti-debug + DB-hook integrity checks.
RASP_SELF_PROTECT=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
